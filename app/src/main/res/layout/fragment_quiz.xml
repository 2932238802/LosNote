<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 栏目多选 + 抽一题 同一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_category_select"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="全部栏目" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_draw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="抽一题" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_scope"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/hint_text"
        android:text="全部栏目" />

    <!-- 翻卡区域 -->
    <com.example.losnote.ui.SwipeCardView
        android:id="@+id/card_quiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/theme_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/card_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_card_category"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@color/tag_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/tag_text"
                    android:textSize="12sp"
                    tools:text="数学" />

                <TextView
                    android:id="@+id/tv_card_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/star_text"
                    android:textSize="15sp"
                    tools:text="★★☆" />
            </LinearLayout>

            <!-- 标题 + 定义/提示滚动区域 -->
            <ScrollView
                android:id="@+id/scroll_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_card_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="8"
                        android:ellipsize="end"
                        tools:text="无限猴子定理" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="?android:attr/listDivider" />

                    <TextView
                        android:id="@+id/tv_card_definition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.25"
                        android:visibility="gone"
                        tools:text="一只猴子无限随机敲键盘……" />

                    <TextView
                        android:id="@+id/tv_card_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/hint_text"
                        android:textSize="13sp"
                        android:text="点击卡片查看答案 · 左右滑动切题" />
                </LinearLayout>
            </ScrollView>

            <!-- 翻面后出现的操作按钮：编辑/删除 + SRS 三档评分 -->
            <LinearLayout
                android:id="@+id/bar_grade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_quiz_edit"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:text="编辑" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_quiz_delete"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="12sp"
                        android:text="删除" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_again"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:text="忘记" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_good"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="16sp"
                        android:text="记得" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_easy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="16sp"
                        android:text="简单"
                        app:backgroundTint="@color/mastered" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </com.example.losnote.ui.SwipeCardView>

</LinearLayout>
